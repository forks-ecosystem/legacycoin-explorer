# LegacyCoin Block Explorer — example configuration
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# These variables are read by the explorer binary (see cmd/explorer/main.go)
# and are loaded into the container via docker-compose env_file.

# legacycoind node connection
EXPLORER_NODE_HOST=127.0.0.1
EXPLORER_NODE_PORT=19556

# RPC credentials (overrides cookie auth when both are set)
EXPLORER_RPC_USER=
EXPLORER_RPC_PASSWORD=

# Optional: use the node .cookie file instead (leave user/password empty)
EXPLORER_COOKIE_FILE=/home/coin/.legacycoin/.cookie

# HTTP port the explorer listens on
EXPLORER_PORT=8084

# Directory for persistent data (bookmarks) inside the container
EXPLORER_DATA_DIR=/data